{
  "expo": {
    "name": "Estoy Bien",
    "slug": "App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#286052"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.estoybien.toyvivo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "targetSdkVersion": 36,
      "predictiveBackGestureEnabled": false,
      "package": "estoybien.goxs.com"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "ee620120-fcfa-4ec0-b363-fbe1fbb5a4ac"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ee620120-fcfa-4ec0-b363-fbe1fbb5a4ac"
    }
  }
}
